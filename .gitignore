# env files (can opt-in for committing if needed)
!.env.example
.env*

# scheduled task API key
SCHEDULED_TASK_API_KEY

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# database
local.db
*.db

# scheduled task files (Excel files for batch processing)
/altas
/bajas
/processed
